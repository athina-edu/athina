#!/usr/bin/env python3
# Thin wrapper around the athina CLI entry point.
# The actual implementation lives in athina/cli.py so that the package can be
# installed via a console_scripts entry point (see setup.py), which keeps the
# package buildable in any context (e.g., Dependabot's dependency graph build).
import os
import sys

# Ensure the project root is importable when running from a source checkout.
sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.realpath(__file__))))

from athina.cli import run

if __name__ == "__main__":
    run()
