[[source]]
name = "pypi"
url = "https://pypi.org/simple"
verify_ssl = true

[dev-packages]

[packages]
athina = {editable = true, path = ".", extras = ["test"]}
pytest = ">=7.0"
pytest-timeout = ">=2.0"
docker = ">=6.0"
# Floors carry the security fixes reported by Dependabot, so a fresh lock cannot
# resolve back to a vulnerable release.
gitpython = ">=3.2.1"
filelock = ">=4.2.1"
urllib3 = ">=2.8.0"
certifi = ">=2026.10.18"

[requires]
python_version = "3.14"
